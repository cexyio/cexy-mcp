{
  "name": "@cexyio/mcp",
  "version": "0.1.0-dev.9",
  "description": "Official Model Context Protocol (MCP) server for the CEXY.io exchange API: market data, account reads and opt-in trading",
  "license": "MIT",
  "author": "CEXY.io",
  "homepage": "https://cexy.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cexyio/cexy-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/cexyio/cexy-mcp/issues"
  },
  "keywords": [
    "cexy",
    "mcp",
    "model-context-protocol",
    "crypto",
    "exchange",
    "trading"
  ],
  "type": "module",
  "bin": {
    "cexy-mcp": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:live": "CEXY_LIVE_TESTS=1 vitest run tests/live.test.ts",
    "scan": "python3 tools/scan_internal.py .",
    "start": "node dist/cli.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@cexyio/cexy": "0.1.0-dev.9",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.4",
    "eslint": "^10.11.0",
    "tsup": "^8.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.2"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
